{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_author}"],
  "contact": {
    "homepage": "${mod_homepage}",
    "sources": "${mod_sources}",
    "issues": "${mod_issues}"
  },
  "license": "${mod_license}",
  "icon": "assets/${mod_id}/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["com.alexlogvin.blockieseconomy.fabric.BlockiesEconomyFabric"]
  },
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "${mc_version_range}",
    "java": ">=${java_level}",
    "fabric-api": "*"
  }
}
